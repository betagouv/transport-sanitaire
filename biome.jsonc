{
  // La racine ne porte aucun code : les apps ont leur configuration, qui étend
  // le socle `biome.base.jsonc`. Ce fichier ne couvre que les fichiers de
  // configuration de la racine.
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "extends": ["./biome.base.jsonc"],
  "files": {
    "includes": ["biome.jsonc", "package.json"]
  }
}
